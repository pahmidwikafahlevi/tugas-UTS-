<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f7f5ef">
  <title>Pustaka — Temukan cerita berikutnya</title>
  <style>
    :root {
      color-scheme: light;
      --ink: #20342f;
      --muted: #74817b;
      --green: #315d4d;
      --green-dark: #244739;
      --paper: #f7f5ef;
      --white: #fffefa;
      --line: #e8e7df;
      --gold: #c49352;
      --serif: Georgia, "Times New Roman", serif;
      font-family: "Segoe UI", Arial, sans-serif;
      color: var(--ink);
      background: var(--paper);
    }

    * { box-sizing: border-box; }
    body { margin: 0; min-width: 320px; }
    button, input, select, textarea { font: inherit; }
    button, a, select { -webkit-tap-highlight-color: transparent; }
    a { color: inherit; text-decoration: none; }
    .wrap { width: min(1120px, calc(100% - 48px)); margin: 0 auto; }

    .topbar {
      height: 76px;
      display: flex;
      align-items: center;
      border-bottom: 1px solid rgba(32, 52, 47, .08);
      background: rgba(247, 245, 239, .94);
    }
    .nav { display: flex; align-items: center; justify-content: space-between; gap: 24px; }
    .brand { display: inline-flex; align-items: center; gap: 11px; font-family: var(--serif); font-size: 23px; font-weight: 700; letter-spacing: -.5px; }
    .brand-mark { width: 35px; height: 35px; display: grid; place-items: center; border-radius: 11px; color: #fff; background: var(--green); }
    .brand-mark svg { width: 19px; height: 19px; }
    .nav-links { display: flex; align-items: center; gap: 32px; color: #66746d; font-size: 14px; }
    .nav-links a { transition: color .2s ease; }
    .nav-links a:hover, .nav-links a[aria-current="page"] { color: var(--green); }
    .nav-links a[aria-current="page"] { font-weight: 700; }
    .nav-note { font-size: 12px; color: var(--muted); }

    .hero { display: grid; grid-template-columns: 1.05fr .95fr; align-items: center; gap: 60px; padding: 66px 0 62px; }
    .eyebrow { display: inline-flex; align-items: center; gap: 9px; color: var(--green); font-size: 11px; font-weight: 800; letter-spacing: 1.6px; text-transform: uppercase; }
    .eyebrow::before { content: ""; width: 22px; height: 1px; background: var(--gold); }
    h1, h2, p { margin-top: 0; }
    h1 { max-width: 550px; margin: 17px 0 15px; font: 500 clamp(42px, 5.2vw, 64px)/1.08 var(--serif); letter-spacing: -2.2px; }
    h1 em { color: var(--green); font-weight: 500; }
    .hero-copy { max-width: 455px; margin-bottom: 0; color: #6d7973; font-size: 15px; line-height: 1.8; }
    .hero-art { min-height: 260px; position: relative; display: grid; place-items: center; overflow: hidden; border-radius: 20px; background: #e7e9df; }
    .hero-art::before, .hero-art::after { content: ""; position: absolute; border: 1px solid rgba(49, 93, 77, .12); border-radius: 50%; }
    .hero-art::before { width: 285px; height: 285px; }
    .hero-art::after { width: 355px; height: 355px; }
    .sun { position: absolute; top: 29px; right: 50px; width: 48px; height: 48px; border-radius: 50%; background: #ddc69b; }
    .book-stack { position: relative; z-index: 1; width: 200px; height: 178px; }
    .book { position: absolute; width: 120px; height: 158px; border-radius: 4px 8px 8px 4px; box-shadow: 9px 13px 22px rgba(34, 49, 40, .15); }
    .book::before { content: ""; position: absolute; left: 10px; top: 0; width: 2px; height: 100%; background: rgba(255,255,255,.25); }
    .book::after { content: ""; position: absolute; left: 24px; right: 15px; bottom: 23px; height: 1px; background: rgba(255,255,255,.45); }
    .book-one { left: 6px; top: 15px; transform: rotate(-12deg); background: #bc8557; }
    .book-two { left: 75px; top: 8px; transform: rotate(9deg); background: #315d4d; }
    .book-three { left: 42px; top: 25px; transform: rotate(-1deg); background: #e7d8b8; }
    .book-three::after { background: rgba(42, 64, 55, .28); }
    .book-title { position: absolute; top: 43px; left: 17px; right: 12px; color: white; font: 15px/1.2 var(--serif); text-align: center; }
    .book-three .book-title { color: #395448; }
    .art-caption { position: absolute; right: 20px; bottom: 18px; color: #68776e; font-size: 11px; letter-spacing: .5px; }

    .content { padding: 0 0 76px; }
    .section-heading { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 22px; }
    .section-heading h2 { margin: 8px 0 0; font: 500 30px/1.2 var(--serif); letter-spacing: -.7px; }
    .step { color: var(--muted); font-size: 12px; }
    .step strong { color: var(--green); }
    .checkout-grid { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(300px, .85fr); align-items: start; gap: 22px; }
    .card { padding: 27px; border: 1px solid var(--line); border-radius: 15px; background: var(--white); box-shadow: 0 8px 30px rgba(41, 54, 46, .035); }
    .card h3 { margin: 0 0 20px; font: 500 21px/1.3 var(--serif); }
    .form-row { display: grid; grid-template-columns: minmax(0, 1fr) 120px auto; align-items: end; gap: 12px; }
    label { display: block; margin-bottom: 8px; color: #47574f; font-size: 12px; font-weight: 700; }
    input, select, textarea { width: 100%; border: 1px solid #e3e5de; border-radius: 8px; outline: none; color: var(--ink); background: #fff; transition: border-color .2s, box-shadow .2s; }
    input, select { height: 45px; padding: 0 12px; }
    textarea { min-height: 89px; padding: 12px; resize: vertical; }
    input:focus, select:focus, textarea:focus { border-color: #7b9b88; box-shadow: 0 0 0 3px rgba(49, 93, 77, .1); }
    .btn { min-height: 45px; padding: 0 18px; border: 0; border-radius: 8px; color: #fff; background: var(--green); font-size: 13px; font-weight: 700; cursor: pointer; transition: background .2s, transform .2s; }
    .btn:hover { background: var(--green-dark); transform: translateY(-1px); }
    .btn:focus-visible, .remove:focus-visible, .close:focus-visible { outline: 3px solid #a9c5b2; outline-offset: 3px; }
    .cart-table-wrap { overflow-x: auto; margin-top: 27px; }
    table { width: 100%; border-collapse: collapse; text-align: left; }
    th { padding: 0 10px 12px; border-bottom: 1px solid var(--line); color: #89928c; font-size: 10px; font-weight: 700; letter-spacing: .8px; text-transform: uppercase; white-space: nowrap; }
    td { padding: 15px 10px; border-bottom: 1px solid #f0f0eb; color: #56645c; font-size: 12px; white-space: nowrap; }
    th:first-child, td:first-child { padding-left: 0; }
    th:last-child, td:last-child { padding-right: 0; }
    .num { text-align: right; }
    .item-name { color: var(--ink); font-weight: 700; }
    .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
    .remove { border: 0; padding: 5px; color: #a06e63; background: none; cursor: pointer; font-size: 12px; }
    .empty { margin: 19px 0 0; color: var(--muted); font-size: 13px; text-align: center; }
    .totals { display: grid; grid-template-columns: 1fr auto; gap: 13px 12px; margin: 20px 0 0; color: #758078; font-size: 13px; }
    .totals dd { margin: 0; color: #45554c; text-align: right; }
    .totals .grand-label, .totals .grand { padding-top: 14px; border-top: 1px solid var(--line); color: var(--ink); font-size: 15px; font-weight: 800; }
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 13px; }
    .full { grid-column: 1 / -1; }
    .form-grid .btn { width: 100%; min-height: 49px; }
    .form-hint { margin: 17px 0 0; color: var(--muted); font-size: 11px; line-height: 1.6; text-align: center; }
    .error { min-height: 0; margin: 0; color: #a64e43; font-size: 12px; }
    .error:not(:empty) { padding: 10px 12px; border-radius: 7px; background: #fff1ed; }
    .toast { position: fixed; right: 24px; bottom: 24px; z-index: 3; max-width: min(390px, calc(100% - 32px)); padding: 15px 19px; border-radius: 10px; color: white; background: var(--green-dark); box-shadow: 0 10px 30px rgba(20, 42, 32, .2); font-size: 13px; }
    .toast[hidden] { display: none; }
    footer { padding: 23px 0; border-top: 1px solid var(--line); color: var(--muted); font-size: 11px; }
    .footer-inner { display: flex; justify-content: space-between; gap: 16px; }

    @media (max-width: 820px) {
      .hero { gap: 35px; padding: 48px 0; }
      .checkout-grid { grid-template-columns: 1fr; }
      .summary-card { order: 0; }
      .buyer-card { order: 1; }
      .nav-links { gap: 17px; }
    }
    @media (max-width: 600px) {
      .wrap { width: min(100% - 32px, 500px); }
      .topbar { height: 65px; }
      .brand { font-size: 20px; }
      .nav-note, .nav-links a:not([aria-current="page"]) { display: none; }
      .nav-links { gap: 0; font-size: 12px; }
      .hero { grid-template-columns: 1fr; gap: 28px; padding: 43px 0 42px; }
      h1 { font-size: 47px; }
      .hero-art { min-height: 220px; }
      .content { padding-bottom: 49px; }
      .section-heading h2 { font-size: 27px; }
      .card { padding: 20px 17px; }
      .form-row { grid-template-columns: 1fr 90px; }
      .form-row .btn { grid-column: 1 / -1; }
      .form-grid { grid-template-columns: 1fr; gap: 14px; }
      .full { grid-column: auto; }
      .footer-inner { flex-direction: column; }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; }
    }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="wrap nav">
      <a class="brand" href="#beranda" aria-label="Pustaka, beranda">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v17H6.5A2.5 2.5 0 0 1 4 17.5z"/><path d="M4 17.5A2.5 2.5 0 0 1 6.5 15H20M8 7h8M8 10h6"/></svg>
        </span>
        Pustaka
      </a>
      <nav class="nav-links" aria-label="Navigasi utama">
        <a href="#beranda">Beranda</a>
        <a href="#pemesanan" aria-current="page">Pemesanan</a>
      </nav>
      <span class="nav-note">Ruang kecil untuk cerita besar.</span>
    </div>
  </header>

  <main>
    <div class="wrap" id="beranda">
      <section class="hero" aria-labelledby="headline">
        <div>
          <span class="eyebrow">Toko buku pilihan</span>
          <h1 id="headline">Cerita baik, <em>selalu</em> menemukan jalan.</h1>
          <p class="hero-copy">Jelajahi bacaan pilihan, pilih yang paling memanggil, lalu kami antar sampai ke depan pintu.</p>
        </div>
        <div class="hero-art" role="img" aria-label="Ilustrasi tiga buku dengan warna hangat">
          <span class="sun"></span>
          <div class="book-stack" aria-hidden="true">
            <div class="book book-one"><span class="book-title">JALAN<br>PULANG</span></div>
            <div class="book book-two"><span class="book-title">KISAH<br>SEBUAH<br>KOTA</span></div>
            <div class="book book-three"><span class="book-title">HALAMAN<br>BARU</span></div>
          </div>
          <span class="art-caption">TEMUKAN BACAAN FAVORITMU</span>
        </div>
      </section>

      <section class="content" id="pemesanan" aria-labelledby="order-heading">
        <div class="section-heading">
          <div>
            <span class="eyebrow">Mudah dan nyaman</span>
            <h2 id="order-heading">Buat pesanan</h2>
          </div>
          <span class="step"><strong>01</strong> Pilih buku &nbsp;—&nbsp; 02 Isi data</span>
        </div>
        <div class="checkout-grid">
          <section class="card summary-card" aria-labelledby="cart-heading">
            <h3 id="cart-heading">Isi keranjang</h3>
            <form id="fTambah" class="form-row">
              <div>
                <label for="pilihBuku">Pilih buku</label>
                <select id="pilihBuku" required></select>
              </div>
              <div>
                <label for="qtyBaru">Jumlah</label>
                <input id="qtyBaru" type="number" min="1" max="99" value="1" required>
              </div>
              <button class="btn" type="submit">+ Tambah buku</button>
            </form>
            <div class="cart-table-wrap">
              <table>
                <thead><tr><th>Judul buku</th><th class="num">Harga</th><th>Jumlah</th><th class="num">Subtotal</th><th><span class="sr-only">Aksi</span></th></tr></thead>
                <tbody id="tbCart"></tbody>
              </table>
            </div>
            <p id="kosong" class="empty">Keranjangmu masih kosong. Yuk, pilih buku!</p>
            <dl class="totals">
              <dt>Subtotal</dt><dd id="subtotal">Rp0</dd>
              <dt>Ongkos kirim</dt><dd id="ongkir">Rp0</dd>
              <dt class="grand-label">Total pembayaran</dt><dd class="grand" id="grand">Rp0</dd>
            </dl>
          </section>

          <section class="card buyer-card" aria-labelledby="buyer-heading">
            <h3 id="buyer-heading">Data pengiriman</h3>
            <form id="fPesan" class="form-grid" novalidate>
              <div class="full">
                <label for="nama">Nama lengkap</label>
                <input id="nama" name="nama" autocomplete="name" placeholder="Nama penerima" required>
              </div>
              <div class="full">
                <label for="hp">Nomor WhatsApp</label>
                <input id="hp" name="hp" type="tel" autocomplete="tel" inputmode="tel" placeholder="08xxxxxxxxxx" required>
              </div>
              <div class="full">
                <label for="alamat">Alamat lengkap</label>
                <textarea id="alamat" name="alamat" autocomplete="street-address" placeholder="Nama jalan, nomor rumah, kecamatan, kota" required></textarea>
              </div>
              <div>
                <label for="ekspedisi">Jasa kirim</label>
                <select id="ekspedisi" name="ekspedisi" required>
                  <option value="Reguler" data-cost="12000">Reguler — Rp12.000</option>
                  <option value="Express" data-cost="22000">Express — Rp22.000</option>
                  <option value="Hemat" data-cost="8000">Hemat — Rp8.000</option>
                </select>
              </div>
              <div>
                <label for="bayar">Pembayaran</label>
                <select id="bayar" name="bayar" required>
                  <option value="">Pilih metode</option>
                  <option>Transfer Bank</option>
                  <option>E-Wallet</option>
                  <option>Bayar di Tempat (COD)</option>
                </select>
              </div>
              <p class="error full" id="pesanErr" role="alert" aria-live="polite"></p>
              <button class="btn full" type="submit">Buat pesanan</button>
            </form>
            <p class="form-hint">Dengan memesan, kamu menyetujui bahwa data pengiriman digunakan untuk memproses pesanan.</p>
          </section>
        </div>
      </section>
    </div>
  </main>
  <footer>
    <div class="wrap footer-inner"><span>© 2025 Pustaka. Teman baik untuk setiap halaman.</span><span>Dibuat dengan cinta untuk para pembaca.</span></div>
  </footer>
  <div class="toast" id="notifikasi" role="status" aria-live="polite" hidden></div>

  <script>
    (() => {
      const books = [
        { id: "senja", title: "Senja di Ujung Cerita", price: 78000 },
        { id: "laut", title: "Laut Bercerita", price: 89000 },
        { id: "filosofi", title: "Filosofi Teras", price: 98000 },
        { id: "bumi", title: "Bumi Manusia", price: 85000 },
        { id: "pulang", title: "Pulang", price: 92000 }
      ];
      const cart = new Map();
      const currency = new Intl.NumberFormat("id-ID", {
        style: "currency", currency: "IDR", maximumFractionDigits: 0
      });
      const bookSelect = document.getElementById("pilihBuku");
      const tbody = document.getElementById("tbCart");
      const shippingSelect = document.getElementById("ekspedisi");
      const notice = document.getElementById("notifikasi");
      let noticeTimer;

      books.forEach((book) => {
        const option = document.createElement("option");
        option.value = book.id;
        option.textContent = `${book.title} — ${currency.format(book.price)}`;
        bookSelect.append(option);
      });

      function renderCart() {
        tbody.replaceChildren();
        let subtotal = 0;
        cart.forEach((quantity, id) => {
          const book = books.find((item) => item.id === id);
          if (!book) return;
          const row = document.createElement("tr");
          const title = document.createElement("td");
          title.className = "item-name";
          title.textContent = book.title;
          const price = document.createElement("td");
          price.className = "num";
          price.textContent = currency.format(book.price);
          const qty = document.createElement("td");
          qty.textContent = quantity;
          const lineTotal = document.createElement("td");
          lineTotal.className = "num";
          lineTotal.textContent = currency.format(book.price * quantity);
          const action = document.createElement("td");
          const remove = document.createElement("button");
          remove.className = "remove";
          remove.type = "button";
          remove.textContent = "Hapus";
          remove.setAttribute("aria-label", `Hapus ${book.title} dari keranjang`);
          remove.addEventListener("click", () => {
            cart.delete(id);
            renderCart();
          });
          action.append(remove);
          row.append(title, price, qty, lineTotal, action);
          tbody.append(row);
          subtotal += book.price * quantity;
        });
        const shipping = subtotal
          ? Number(shippingSelect.selectedOptions[0].dataset.cost)
          : 0;
        document.getElementById("kosong").hidden = cart.size > 0;
        document.getElementById("subtotal").textContent = currency.format(subtotal);
        document.getElementById("ongkir").textContent = currency.format(shipping);
        document.getElementById("grand").textContent = currency.format(subtotal + shipping);
      }

      function showNotice(message) {
        notice.textContent = message;
        notice.hidden = false;
        window.clearTimeout(noticeTimer);
        noticeTimer = window.setTimeout(() => { notice.hidden = true; }, 5000);
      }

      document.getElementById("fTambah").addEventListener("submit", (event) => {
        event.preventDefault();
        const id = bookSelect.value;
        const quantity = Number(document.getElementById("qtyBaru").value);
        if (!books.some((book) => book.id === id) || !Number.isInteger(quantity) || quantity < 1 || quantity > 99) {
          showNotice("Pilih buku dan jumlah antara 1 sampai 99.");
          return;
        }
        cart.set(id, Math.min(99, (cart.get(id) || 0) + quantity));
        renderCart();
        document.getElementById("qtyBaru").value = "1";
      });

      shippingSelect.addEventListener("change", renderCart);
      document.getElementById("fPesan").addEventListener("submit", (event) => {
        event.preventDefault();
        const error = document.getElementById("pesanErr");
        error.textContent = "";
        if (cart.size === 0) {
          error.textContent = "Keranjang masih kosong. Tambahkan buku sebelum membuat pesanan.";
          bookSelect.focus();
          return;
        }
        const form = event.currentTarget;
        if (!form.reportValidity()) return;
        const phone = document.getElementById("hp").value.trim();
        const phoneDigits = phone.replace(/\D/g, "");
        if (!/^\+?[0-9][0-9\s-]{7,16}$/.test(phone) || phoneDigits.length < 8 || phoneDigits.length > 17) {
          error.textContent = "Masukkan nomor telepon yang valid (8–17 digit).";
          document.getElementById("hp").focus();
          return;
        }
        const name = document.getElementById("nama").value.trim();
        const total = document.getElementById("grand").textContent;
        showNotice(`Terima kasih, ${name}! Pesanan demo sebesar ${total} berhasil disiapkan. Pesanan belum dikirim ke server.`);
        cart.clear();
        form.reset();
        shippingSelect.value = "Reguler";
        renderCart();
      });

      renderCart();
    })();
  </script>
</body>
</html>
